{
  "compilerOptions": {
    "outDir": "./dist",

    // Environment Settings
    "module": "commonjs",
    "target": "ES2020",
    "lib": ["ES2020"],
    "types": ["node"],

    // Module Resolution
    "ignoreDeprecations": "5.0",
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,

    // Strict Typechecking
    "strict": true,
    "noUncheckedIndexedAccess": true,

    // Other Outputs
    "sourceMap": true,

    "skipLibCheck": true
  },
  "include": ["src/**/*", "api/**/*"]
}